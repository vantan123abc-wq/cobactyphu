PORT=5000

# Supabase project's JWT secret (Dashboard → Settings → API → JWT Settings).
# Required by backend/src/auth/authMiddleware.js once it's wired into a route
# (not yet, as of P03-T02) — different from the anon key, never share it.
SUPABASE_JWT_SECRET=

# Full DB connection — infrastructure/database/supabaseClient.js requires BOTH
# of these (service_role, not anon) before any room/game persistence works.
# Still unset as of P11's E2E smoke test (scripts/e2e-smoke.js) — the one
# remaining real blocker; SUPABASE_JWT_SECRET alone only unblocks auth/socket
# handshake verification, not roomRepository.js's/gameRepository.js's writes.
SUPABASE_SERVICE_ROLE_KEY=

# Public-safe project URL + anon key (Dashboard → Settings → API) — used only
# by scripts/e2e-smoke.js's own Supabase *auth* client (sign in/up a test
# user to get a real JWT). Same values as frontend/.env's
# VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY. Not a substitute for
# SUPABASE_SERVICE_ROLE_KEY above.
SUPABASE_URL=
SUPABASE_ANON_KEY=
